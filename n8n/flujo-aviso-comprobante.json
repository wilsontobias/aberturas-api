        40
      ],
      "parameters": {
        "fromEmail": "={{ $('Configuración').first().json.mail_from }}",
        "toEmail": "={{ $('Configuración').first().json.mail_vendedor }}",
        "subject": "={{ $json.asunto }}",
        "emailFormat": "text",
        "text": "={{ $json.text }}",
        "options": {
          "appendAttribution": false
        }
      },
      "credentials": {
