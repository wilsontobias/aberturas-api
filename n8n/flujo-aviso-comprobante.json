    {
      "id": "w9",
      "name": "Armar el aviso",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        40
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const d = $('Ordenar datos').first().json;\nconst money = (n) => '$ ' + Number(n).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst p = $input.first().json;\n\nconst text = [\n  `${p.etiqueta}Un cliente subió el comprobante de la seña.`,\n  '',\n  `Pedido N.º ${d.pedido}`,\n  `Cliente: ${d.cliente} (${d.email_cliente})`,\n  `Seña a verificar: ${money(d.monto)}`,\n  d.fabricacion ? 'El pedido lleva fabricación.' : 'El pedido sale de stock.',\n  '',\n  'Entrá al sistema > Pedidos para aprobarlo o rechazarlo.',\n].join('\\n');\n\nreturn [{ json: { asunto: `${p.etiqueta}Comprobante nuevo del pedido N.º ${d.pedido}`, text, prioridad: p.prioridad } }];\n"
      }
    },
    {
      "id": "w10",
