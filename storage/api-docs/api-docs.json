                "summary": "Crear producto",
                "description": "Crea un producto nuevo en el catálogo. Solo administradores.",
                "operationId": "e8185e307706e2cd84bbcf5171e2f09d",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "category_id",
                                    "material_id",
                                    "name",
                                    "width_cm",
                                    "height_cm",
                                    "price",
                                    "stock"
                                ],
                                "properties": {
                                    "category_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "material_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "name": {
                                        "type": "string",
                                        "example": "Ventana batiente de aluminio",
                                        "maxLength": 150
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Ventana de una hoja con vidrio simple.",
                                        "nullable": true
                                    },
                                    "width_cm": {
                                        "type": "integer",
                                        "example": 60,
                                        "minimum": 1
                                    },
                                    "height_cm": {
                                        "type": "integer",
                                        "example": 90,
                                        "minimum": 1
                                    },
                                    "color": {
                                        "type": "string",
                                        "example": "Blanco",
                                        "nullable": true
                                    },
                                    "price": {
                                        "type": "number",
                                        "example": 95000.5,
                                        "minimum": 0
                                    },
                                    "stock": {
                                        "type": "integer",
                                        "example": 5,
                                        "minimum": 0
                                    },
                                    "image": {
                                        "type": "string",
                                        "example": "https://ejemplo.com/ventana.jpg",
                                        "nullable": true
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Producto creado correctamente."
                    },
                    "401": {
                        "description": "No estás autenticado."
                    },
                    "403": {
                        "description": "No tenés permiso para realizar esta acción."
                    },
                    "422": {
                        "description": "Los datos proporcionados no son válidos."
                    }
                },
                "security": [
