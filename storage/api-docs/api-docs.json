                        "schema": {
                            "type": "integer",
                            "enum": [
                                0,
                                1
                            ]
                        }
                    },
                    {
                        "name": "category_id",
                        "in": "query",
                        "description": "ID de la categoría para filtrar",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
