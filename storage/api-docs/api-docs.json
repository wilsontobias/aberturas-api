{
    "openapi": "3.0.0",
    "info": {
        "title": "API Sistema de Gestión de Pedidos de Aberturas",
        "description": "API REST para gestionar los pedidos de una empresa de aberturas.",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://127.0.0.1:8000",
            "description": "Servidor local"
        }
    ],
    "paths": {
        "/api/register": {
            "post": {
                "tags": [
                    "Autenticación"
                ],
                "summary": "Registrarse como cliente",
                "description": "Crea un usuario nuevo con rol de usuario operativo y tipo cliente, y devuelve un token de acceso.",
                "operationId": "8a56853624e025573120a09a4c75d468",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "required": [
                                    "first_name",
                                    "last_name",
                                    "email",
                                    "password",
                                    "locality_id",
                                    "phone_1",
                                    "phone_2"
                                ],
                                "properties": {
                                    "first_name": {
                                        "type": "string",
                                        "example": "Juan",
                                        "maxLength": 100
                                    },
                                    "last_name": {
                                        "type": "string",
                                        "example": "Pérez",
                                        "maxLength": 100
                                    },
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "juan@ejemplo.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "format": "password",
                                        "example": "Cliente123",
                                        "minLength": 8
                                    },
                                    "locality_id": {
                                        "type": "integer",
                                        "example": 2
                                    },
                                    "phone_1": {
                                        "type": "string",
                                        "example": "3454111111",
                                        "maxLength": 30
                                    },
                                    "phone_2": {
                                        "type": "string",
                                        "example": "3454222222",
                                        "maxLength": 30
                                    }
                                },
                                "type": "object"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Usuario registrado correctamente."
                    },
                    "422": {
                        "description": "Los datos proporcionados no son válidos."
                    }
                }
            }
        },
        "/api/localities": {
            "get": {
                "tags": [
                    "Localidades"
                ],
                "summary": "Listar localidades",
                "description": "Devuelve las localidades activas ordenadas por nombre, con su provincia. Se puede filtrar por provincia. No requiere token.",
                "operationId": "606013a0b341f7c95cccee6e8730587b",
                "parameters": [
                    {
                        "name": "province_id",
                        "in": "query",
                        "description": "ID de la provincia para filtrar (opcional)",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Localidades obtenidas correctamente."
                    }
                }
            }
        },
        "/api/localities/{id}": {
            "get": {
                "tags": [
                    "Localidades"
                ],
                "summary": "Ver una localidad",
                "description": "Devuelve una localidad con su provincia. No requiere token.",
                "operationId": "9cb7a206b0f8a6fb71393aac5df83cba",
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "description": "ID de la localidad",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "example": 1
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Localidad obtenida correctamente."
                    },
                    "404": {
                        "description": "Localidad no encontrada."
                    }
                }
            }
        },
        "/api/provinces": {
            "get": {
                "tags": [
                    "Provincias"
                ],
                "summary": "Listar provincias",
                "description": "Devuelve todas las provincias ordenadas por nombre. No requiere token.",
                "operationId": "85624171910502f5871da8213efcc4c7",
                "responses": {
                    "200": {
                        "description": "Provincias obtenidas correctamente."
                    }
                }
            }
        }
    },
    "components": {
        "securitySchemes": {
            "sanctum": {
                "type": "http",
                "description": "Token de autenticación generado por Laravel Sanctum.",
                "bearerFormat": "Token Sanctum",
                "scheme": "bearer"
            }
        }
    },
    "tags": [
        {
            "name": "Autenticación",
            "description": "Autenticación"
        },
        {
            "name": "Localidades",
            "description": "Localidades"
        },
        {
            "name": "Provincias",
            "description": "Provincias"
        }
    ]
}