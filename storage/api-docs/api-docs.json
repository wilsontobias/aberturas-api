        "/api/products": {
            "get": {
                "tags": [
                    "Productos"
                ],
                "summary": "Ver el catálogo",
                "description": "Devuelve los productos activos con su categoría, material y disponibilidad. Se puede filtrar por stock y por categoría. No requiere token.",
